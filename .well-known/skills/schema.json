{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/EPDCommerce/AgentSkills/blob/main/.well-known/skills/schema.json",
  "title": "EPD Skills Manifest",
  "description": "Schema for the .well-known/skills/index.json manifest published by an EPD Skills repository. Project-local convention; not part of any public skills standard.",
  "type": "object",
  "required": ["name", "version", "skills"],
  "additionalProperties": false,
  "properties": {
    "name": {
      "type": "string",
      "minLength": 1,
      "description": "Manifest package name."
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+(?:[-+].+)?$",
      "description": "Semver version of the manifest."
    },
    "publisher": {
      "type": "string",
      "minLength": 1
    },
    "homepage": {
      "type": "string",
      "format": "uri"
    },
    "repository": {
      "type": "string",
      "format": "uri"
    },
    "license": {
      "type": "string",
      "minLength": 1
    },
    "api_version": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
      "description": "EPD Commerce API version this manifest targets (YYYY-MM-DD)."
    },
    "skills": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/skill" }
    }
  },
  "$defs": {
    "skill": {
      "type": "object",
      "required": ["name", "description", "files"],
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{1,63}$",
          "description": "Skill name. Lowercase, kebab-case, 2-64 chars."
        },
        "kind": {
          "type": "string",
          "enum": ["integration", "workflow"],
          "description": "integration: dev-facing IDE-loaded skill. workflow: operator-agent MCP-loaded skill."
        },
        "description": {
          "type": "string",
          "minLength": 20,
          "maxLength": 1024
        },
        "files": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_./-]+$"
          }
        }
      }
    }
  }
}
