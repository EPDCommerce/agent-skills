{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/EPDCommerce/AgentSkills/blob/main/.well-known/skills/skill-frontmatter.schema.json",
  "title": "EPD Skill Frontmatter",
  "description": "Schema for the YAML frontmatter at the top of every SKILL.md in this repository.",
  "type": "object",
  "required": ["name", "description", "metadata"],
  "additionalProperties": false,
  "properties": {
    "name": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{1,63}$"
    },
    "description": {
      "type": "string",
      "minLength": 40,
      "maxLength": 2048,
      "description": "Triggering description. Should follow the 'Use when ... Triggers when ... Skip when ...' pattern."
    },
    "compatibility": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "license": {
      "type": "string"
    },
    "allowed-tools": {
      "type": "array",
      "items": { "type": "string" }
    },
    "metadata": {
      "type": "object",
      "required": ["version", "api_version"],
      "additionalProperties": true,
      "properties": {
        "version": {
          "type": "string",
          "pattern": "^\\d+\\.\\d+\\.\\d+(?:[-+].+)?$"
        },
        "api_version": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        }
      }
    }
  }
}
